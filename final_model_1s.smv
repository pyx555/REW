-- ==================================================
-- 验证属性 (基于 EnviRE 2024 论文)
-- ==================================================

-- Valid_Transition_from_charging
CTLSPEC AG (state = charging -> AX (state = standby | state = charging | state = error | state = cleaning))

-- Valid_Transition_from_cleaning
CTLSPEC AG (state = cleaning -> AX (state = error | state = returning | state = paused | state = cleaning | state = sleep))

-- Valid_Transition_from_do_not_disturb
CTLSPEC AG (state = do_not_disturb -> AX (state = standby | state = do_not_disturb | state = sleep))

-- Valid_Transition_from_error
CTLSPEC AG (state = error -> AX (state = standby | state = error | state = charging | state = sleep))

-- Valid_Transition_from_firmware_updating
CTLSPEC AG (state = firmware_updating -> AX (state = firmware_updating | state = standby | state = error | state = sleep))

-- Valid_Transition_from_off
CTLSPEC AG (state = off -> AX (state = standby | state = charging | state = off))

-- Valid_Transition_from_paused
CTLSPEC AG (state = paused -> AX (state = returning | state = paused | state = spot_cleaning | state = cleaning | state = sleep))

-- Valid_Transition_from_returning
CTLSPEC AG (state = returning -> AX (state = error | state = returning | state = standby | state = charging | state = sleep))

-- Valid_Transition_from_sleep
CTLSPEC AG (state = sleep -> AX (state = standby | state = sleep | state = off))

-- Valid_Transition_from_spot_cleaning
CTLSPEC AG (state = spot_cleaning -> AX (state = error | state = paused | state = spot_cleaning | state = standby | state = sleep))

-- Valid_Transition_from_standby
CTLSPEC AG (state = standby -> AX (state = off | state = spot_cleaning | state = standby | state = do_not_disturb | state = wifi_waiting | state = cleaning | state = sleep))

-- Valid_Transition_from_wifi_connected
CTLSPEC AG (state = wifi_connected -> AX (state = firmware_updating | state = standby | state = wifi_connected | state = sleep))

-- Valid_Transition_from_wifi_connecting
CTLSPEC AG (state = wifi_connecting -> AX (state = wifi_connected | state = wifi_connecting | state = standby | state = sleep))

-- Valid_Transition_from_wifi_waiting
CTLSPEC AG (state = wifi_waiting -> AX (state = sleep | state = wifi_waiting | state = off | state = wifi_connecting))

-- Resettability
CTLSPEC AG (EF (state = off))
