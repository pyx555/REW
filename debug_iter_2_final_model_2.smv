    state = drying & !app_start_wash & !battery_full & !cloth_dirty & !dock_failed & !dock_reached_charge & !dock_reached_wash & dry_done & !fault_detected & !fault_resolved_and_restart & !long_press_child_lock & !long_press_clean_and_child_lock & !long_press_power & !long_press_reset & !low_battery & !operation_done & !resume_cleaning & !resume_mopping & !resume_returning & !short_press_any & !short_press_clean_mop & !short_press_clean_on_dock & !short_press_clean_sweep & !start_return_from_pause & !task_done & !timeout_10min & !timeout_6h & !wake_up & !wash_condition_fail & !wash_done : start_charging_after_dry;
    state = mopping & !app_start_wash & !battery_full & cloth_dirty & !dock_failed & !dock_reached_charge & !dock_reached_wash & !dry_done & !fault_detected & !fault_resolved_and_restart & !long_press_child_lock & !long_press_clean_and_child_lock & !long_press_power & !long_press_reset & !low_battery & !operation_done & !resume_cleaning & !resume_mopping & !resume_returning & !short_press_any & !short_press_clean_mop & !short_press_clean_on_dock & !short_press_clean_sweep & !start_return_from_pause & !task_done & !timeout_10min & !timeout_6h & !wake_up & !wash_condition_fail & !wash_done : cloth_dirty_return;
    state = sleep & !app_start_wash & !battery_full & !cloth_dirty & !dock_failed & !dock_reached_charge & !dock_reached_wash & !dry_done & !fault_detected & !fault_resolved_and_restart & !long_press_child_lock & !long_press_clean_and_child_lock & !long_press_power & !long_press_reset & !low_battery & !operation_done & !resume_cleaning & !resume_mopping & !resume_returning & !short_press_any & !short_press_clean_mop & !short_press_clean_on_dock & !short_press_clean_sweep & !start_return_from_pause & !task_done & !timeout_10min & !timeout_6h & wake_up & !wash_condition_fail & !wash_done : wake_from_sleep;
    !app_start_wash & !battery_full & !cloth_dirty & !dock_failed & !dock_reached_charge & !dock_reached_wash & !dry_done & fault_detected & !fault_resolved_and_restart & !long_press_child_lock & !long_press_clean_and_child_lock & !long_press_power & !long_press_reset & !low_battery & !operation_done & !resume_cleaning & !resume_mopping & !resume_returning & !short_press_any & !short_press_clean_mop & !short_press_clean_on_dock & !short_press_clean_sweep & !start_return_from_pause & !task_done & !timeout_10min & !timeout_6h & !wake_up & !wash_condition_fail & !wash_done : fault_alert;
    state = error & !app_start_wash & !battery_full & !cloth_dirty & !dock_failed & !dock_reached_charge & !dock_reached_wash & !dry_done & !fault_detected & fault_resolved_and_restart & !long_press_child_lock & !long_press_clean_and_child_lock & !long_press_power & !long_press_reset & !low_battery & !operation_done & !resume_cleaning & !resume_mopping & !resume_returning & !short_press_any & !short_press_clean_mop & !short_press_clean_on_dock & !short_press_clean_sweep & !start_return_from_pause & !task_done & !timeout_10min & !timeout_6h & !wake_up & !wash_condition_fail & !wash_done : recover_from_error;
    state = washing & !app_start_wash & !battery_full & !cloth_dirty & !dock_failed & !dock_reached_charge & !dock_reached_wash & !dry_done & !fault_detected & !fault_resolved_and_restart & !long_press_child_lock & !long_press_clean_and_child_lock & !long_press_power & !long_press_reset & !low_battery & !operation_done & !resume_cleaning & !resume_mopping & !resume_returning & !short_press_any & !short_press_clean_mop & !short_press_clean_on_dock & !short_press_clean_sweep & !start_return_from_pause & !task_done & !timeout_10min & !timeout_6h & !wake_up & wash_condition_fail & !wash_done : wash_error;
    state = returning & !app_start_wash & !battery_full & !cloth_dirty & dock_failed & !dock_reached_charge & !dock_reached_wash & !dry_done & !fault_detected & !fault_resolved_and_restart & !long_press_child_lock & !long_press_clean_and_child_lock & !long_press_power & !long_press_reset & !low_battery & !operation_done & !resume_cleaning & !resume_mopping & !resume_returning & !short_press_any & !short_press_clean_mop & !short_press_clean_on_dock & !short_press_clean_sweep & !start_return_from_pause & !task_done & !timeout_10min & !timeout_6h & !wake_up & !wash_condition_fail & !wash_done : return_error;
    TRUE : auto_power_off;
  esac;

-- Reachability_of_standby
CTLSPEC EF (state = standby)

-- Reachability_of_cleaning
CTLSPEC EF (state = cleaning)

-- Reachability_of_mopping
CTLSPEC EF (state = mopping)

-- Reachability_of_returning
CTLSPEC EF (state = returning)

-- Reachability_of_charging
CTLSPEC EF (state = charging)

-- Reachability_of_washing
CTLSPEC EF (state = washing)

-- Reachability_of_drying
CTLSPEC EF (state = drying)

-- Reachability_of_paused
CTLSPEC EF (state = paused)

-- Reachability_of_sleep
CTLSPEC EF (state = sleep)

-- Reachability_of_error
CTLSPEC EF (state = error)

-- Reachability_of_do_not_disturb
CTLSPEC EF (state = do_not_disturb)

-- Reachability_of_resetting
CTLSPEC EF (state = resetting)

-- Reachability_of_connecting
CTLSPEC EF (state = connecting)

-- Resettability
CTLSPEC AG (EF (state = off))
