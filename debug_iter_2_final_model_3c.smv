-- SMV DEBUG Model
-- Initial State: off

MODULE main
VAR
  state : {charging, cleaning, cliff_detected, do_not_disturb, error, mapping, off, paused, resetting, returning, sleep, standby, stuck, tilted, wifi_offline};
  battery_full : boolean;
  bumper_stuck : boolean;
  cliff_sensor_dirty : boolean;
