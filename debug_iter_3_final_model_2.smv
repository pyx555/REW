-- ==================================================
-- 验证属性 (基于 EnviRE 2024 论文)
-- ==================================================

-- [连通性] 不存在从初始状态无法到达的状态。
CTLSPEC EF (state = standby)  -- Reachability_of_standby
CTLSPEC EF (state = cleaning)  -- Reachability_of_cleaning
CTLSPEC EF (state = mopping)  -- Reachability_of_mopping
CTLSPEC EF (state = returning)  -- Reachability_of_returning
CTLSPEC EF (state = charging)  -- Reachability_of_charging
CTLSPEC EF (state = washing)  -- Reachability_of_washing
CTLSPEC EF (state = drying)  -- Reachability_of_drying
CTLSPEC EF (state = paused)  -- Reachability_of_paused
CTLSPEC EF (state = sleep)  -- Reachability_of_sleep
CTLSPEC EF (state = error)  -- Reachability_of_error
CTLSPEC EF (state = do_not_disturb)  -- Reachability_of_do_not_disturb
CTLSPEC EF (state = resetting)  -- Reachability_of_resetting
CTLSPEC EF (state = connecting)  -- Reachability_of_connecting

-- [可重置性] 对于每个状态，都存在一条路径回到初始状态。
CTLSPEC AG (EF (state = off))  -- Resettability
