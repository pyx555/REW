digraph finite_state_machine {
    rankdir = LR;
    node [shape = circle];
        "" [shape=none, width=0];
    "" -> "off";
    "off" -> "charging" [ label = "place_on_dock / none" ];
    "off" -> "charging" [ label = "long_press_power_on_dock / none" ];
    "off" -> "standby" [ label = "long_press_power_off_dock / none" ];
    "off" -> "off" [ label = "* / none" ];
    "standby" -> "cleaning" [ label = "short_press_clean / start_cleaning" ];
    "standby" -> "spot_cleaning" [ label = "long_press_home / start_spot_cleaning" ];
    "standby" -> "off" [ label = "long_press_power / shutdown" ];
    "standby" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "standby" -> "cleaning" [ label = "scheduled_time / start_scheduled_cleaning" ];
    "standby" -> "wifi_waiting" [ label = "activate_wifi / start_wifi_setup" ];
    "standby" -> "do_not_disturb" [ label = "activate_dnd / enter_do_not_disturb" ];
    "standby" -> "standby" [ label = "* / none" ];
    "cleaning" -> "paused" [ label = "press_any_key / pause_cleaning" ];
    "cleaning" -> "returning" [ label = "cleaning_complete / start_returning" ];
    "cleaning" -> "returning" [ label = "low_battery / start_returning" ];
    "cleaning" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "cleaning" -> "cleaning" [ label = "cleaning_less_10min / restart_cleaning" ];
    "cleaning" -> "error" [ label = "sensor_error / alert_error" ];
    "cleaning" -> "cleaning" [ label = "* / none" ];
    "spot_cleaning" -> "paused" [ label = "press_any_key / pause_spot_cleaning" ];
    "spot_cleaning" -> "standby" [ label = "spot_cleaning_complete / return_to_start" ];
    "spot_cleaning" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "spot_cleaning" -> "error" [ label = "sensor_error / alert_error" ];
    "spot_cleaning" -> "spot_cleaning" [ label = "* / none" ];
    "paused" -> "cleaning" [ label = "short_press_clean / resume_cleaning" ];
    "paused" -> "returning" [ label = "short_press_home / end_cleaning_and_return" ];
    "paused" -> "spot_cleaning" [ label = "long_press_home / end_current_and_start_spot" ];
    "paused" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "paused" -> "paused" [ label = "* / none" ];
    "returning" -> "charging" [ label = "dock_success / start_charging" ];
    "returning" -> "standby" [ label = "dock_fail / return_to_start" ];
    "returning" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "returning" -> "error" [ label = "sensor_error / alert_error" ];
    "returning" -> "returning" [ label = "* / none" ];
    "charging" -> "cleaning" [ label = "short_press_clean / start_cleaning" ];
    "charging" -> "standby" [ label = "battery_full / stop_charging" ];
    "charging" -> "error" [ label = "charge_error / alert_error" ];
    "charging" -> "charging" [ label = "* / none" ];
    "sleep" -> "standby" [ label = "press_any_key / wake_up" ];
    "sleep" -> "off" [ label = "timeout_12h / shutdown_after_sleep" ];
    "sleep" -> "sleep" [ label = "timeout_10min / none" ];
    "sleep" -> "sleep" [ label = "* / none" ];
    "error" -> "standby" [ label = "fault_resolved / reset_to_standby" ];
    "error" -> "charging" [ label = "place_on_dock / charge_after_error" ];
    "error" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "error" -> "error" [ label = "* / none" ];
    "wifi_waiting" -> "wifi_connecting" [ label = "start_connection / connecting_to_wifi" ];
    "wifi_waiting" -> "off" [ label = "timeout_1h / wifi_off" ];
    "wifi_waiting" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "wifi_waiting" -> "wifi_waiting" [ label = "* / none" ];
    "wifi_connecting" -> "wifi_connected" [ label = "connection_success / wifi_connected_ok" ];
    "wifi_connecting" -> "standby" [ label = "connection_fail / wifi_setup_failed" ];
    "wifi_connecting" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "wifi_connecting" -> "wifi_connecting" [ label = "* / none" ];
    "wifi_connected" -> "standby" [ label = "deactivate_wifi / wifi_off" ];
    "wifi_connected" -> "firmware_updating" [ label = "start_update / begin_firmware_update" ];
    "wifi_connected" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "wifi_connected" -> "wifi_connected" [ label = "* / none" ];
    "do_not_disturb" -> "standby" [ label = "do_not_disturb_timeout / exit_do_not_disturb" ];
    "do_not_disturb" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "do_not_disturb" -> "standby" [ label = "activate_dnd / exit_do_not_disturb" ];
    "do_not_disturb" -> "do_not_disturb" [ label = "* / none" ];
    "firmware_updating" -> "standby" [ label = "update_success / firmware_updated" ];
    "firmware_updating" -> "error" [ label = "update_fail / firmware_update_error" ];
    "firmware_updating" -> "sleep" [ label = "timeout_10min / enter_sleep" ];
    "firmware_updating" -> "firmware_updating" [ label = "* / none" ];
}