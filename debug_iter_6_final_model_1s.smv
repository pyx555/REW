    TRUE : begin_firmware_update;
  esac;

-- Valid_Transition_from_charging
CTLSPEC AG (state = charging -> AX (state = cleaning | state = charging | state = wifi_waiting | state = standby | state = error))

-- Valid_Transition_from_cleaning
CTLSPEC AG (state = cleaning -> AX (state = cleaning | state = returning | state = paused | state = error))

-- Valid_Transition_from_error
CTLSPEC AG (state = error -> AX (state = charging | state = sleep | state = off | state = standby))

-- Valid_Transition_from_factory_resetting
CTLSPEC AG (state = factory_resetting -> AX (state = factory_resetting | state = standby))

-- Valid_Transition_from_firmware_updating
CTLSPEC AG (state = firmware_updating -> AX (state = firmware_updating | state = standby))

-- Valid_Transition_from_off
CTLSPEC AG (state = off -> AX (state = factory_resetting | state = standby))

-- Valid_Transition_from_paused
CTLSPEC AG (state = paused -> AX (state = cleaning | state = spot_cleaning | state = returning | state = charging | state = sleep))

-- Valid_Transition_from_returning
CTLSPEC AG (state = returning -> AX (state = charging | state = paused | state = error))

-- Valid_Transition_from_sleep
CTLSPEC AG (state = sleep -> AX (state = off | state = standby))

-- Valid_Transition_from_spot_cleaning
CTLSPEC AG (state = spot_cleaning -> AX (state = paused | state = error))

-- Valid_Transition_from_standby
CTLSPEC AG (state = standby -> AX (state = off | state = cleaning | state = spot_cleaning | state = wifi_waiting | state = sleep))

-- Valid_Transition_from_system_resetting
CTLSPEC AG (state = system_resetting -> AX (state = system_resetting | state = standby))

-- Valid_Transition_from_wifi_connected
CTLSPEC AG (state = wifi_connected -> AX (state = firmware_updating | state = system_resetting | state = standby))

-- Valid_Transition_from_wifi_connecting
CTLSPEC AG (state = wifi_connecting -> AX (state = wifi_connecting | state = wifi_connected))

-- Valid_Transition_from_wifi_waiting
CTLSPEC AG (state = wifi_waiting -> AX (state = wifi_waiting | state = wifi_connecting))

-- Resettability
CTLSPEC AG (EF (state = off))
