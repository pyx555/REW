    state = error & !app_connect_initiated & !app_connected & !battery_full & !charging_error & !cleaning_completed & !cleaning_completed_quick & !dock_detected & !dock_not_found & !error_critical & !error_resolved & !factory_reset_completed & !firmware_update_completed & !internal_error & !long_home_short_reset & !long_press_both_buttons & !long_press_home & !long_press_power & !low_battery & !placed_on_dock & !press_any_key & !sensor_error & !short_press_clean & !short_press_home & !spot_cleaning_completed & !start_firmware_update & !start_system_reset & !system_reset_completed & timeout_10min & !timeout_12h & !timeout_1h & !wifi_disconnected : error_timeout_sleep;
    state = error & !app_connect_initiated & !app_connected & !battery_full & !charging_error & !cleaning_completed & !cleaning_completed_quick & !dock_detected & !dock_not_found & !error_critical & !error_resolved & !factory_reset_completed & !firmware_update_completed & !internal_error & !long_home_short_reset & !long_press_both_buttons & !long_press_home & !long_press_power & !low_battery & placed_on_dock & !press_any_key & !sensor_error & !short_press_clean & !short_press_home & !spot_cleaning_completed & !start_firmware_update & !start_system_reset & !system_reset_completed & !timeout_10min & !timeout_12h & !timeout_1h & !wifi_disconnected : error_dock_charge;
    state = charging & !app_connect_initiated & !app_connected & !battery_full & charging_error & !cleaning_completed & !cleaning_completed_quick & !dock_detected & !dock_not_found & !error_critical & !error_resolved & !factory_reset_completed & !firmware_update_completed & !internal_error & !long_home_short_reset & !long_press_both_buttons & !long_press_home & !long_press_power & !low_battery & !placed_on_dock & !press_any_key & !sensor_error & !short_press_clean & !short_press_home & !spot_cleaning_completed & !start_firmware_update & !start_system_reset & !system_reset_completed & !timeout_10min & !timeout_12h & !timeout_1h & !wifi_disconnected : indicate_charging_error;
    state = wifi_waiting & app_connect_initiated & !app_connected & !battery_full & !charging_error & !cleaning_completed & !cleaning_completed_quick & !dock_detected & !dock_not_found & !error_critical & !error_resolved & !factory_reset_completed & !firmware_update_completed & !internal_error & !long_home_short_reset & !long_press_both_buttons & !long_press_home & !long_press_power & !low_battery & !placed_on_dock & !press_any_key & !sensor_error & !short_press_clean & !short_press_home & !spot_cleaning_completed & !start_firmware_update & !start_system_reset & !system_reset_completed & !timeout_10min & !timeout_12h & !timeout_1h & !wifi_disconnected : start_wifi_connection;
    state = wifi_connecting & !app_connect_initiated & app_connected & !battery_full & !charging_error & !cleaning_completed & !cleaning_completed_quick & !dock_detected & !dock_not_found & !error_critical & !error_resolved & !factory_reset_completed & !firmware_update_completed & !internal_error & !long_home_short_reset & !long_press_both_buttons & !long_press_home & !long_press_power & !low_battery & !placed_on_dock & !press_any_key & !sensor_error & !short_press_clean & !short_press_home & !spot_cleaning_completed & !start_firmware_update & !start_system_reset & !system_reset_completed & !timeout_10min & !timeout_12h & !timeout_1h & !wifi_disconnected : wifi_connected;
    state = wifi_connected & !app_connect_initiated & !app_connected & !battery_full & !charging_error & !cleaning_completed & !cleaning_completed_quick & !dock_detected & !dock_not_found & !error_critical & !error_resolved & !factory_reset_completed & !firmware_update_completed & !internal_error & !long_home_short_reset & !long_press_both_buttons & !long_press_home & !long_press_power & !low_battery & !placed_on_dock & !press_any_key & !sensor_error & !short_press_clean & !short_press_home & !spot_cleaning_completed & !start_firmware_update & !start_system_reset & !system_reset_completed & !timeout_10min & !timeout_12h & !timeout_1h & wifi_disconnected : exit_wifi_mode;
